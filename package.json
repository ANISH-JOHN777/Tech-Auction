{
  "name": "tech-auction-platform",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "install:all": "npm install --workspaces",
    "db:migrate": "node apps/server/src/db/migrate.js",
    "db:seed": "node apps/server/src/db/seed.js",
    "db:health": "node apps/server/src/db/health.js",
    "test": "node --test apps/server/src/__tests__/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
